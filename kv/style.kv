#:import hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

<Root>:
    transition: FadeTransition(duration=.3)

# Общие стили для адаптивности и тёмной темы
<Screen>:
    adaptive_height: True
    canvas.before:
        Color:
            rgba: app.theme_cls.bg_dark if app.theme_cls.theme_style == "Dark" else hex("#E8F5E8")
        Rectangle:
            pos: self.pos
            size: self.size

# ===================== ЛОГИН С КНОПКАМИ =====================
<LoginScreen>:
    name: "login"
    FloatLayout:
        # Верхняя панель с кнопками
        MDBoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: [dp(16), dp(10)]
            pos_hint: {"top": 1}
            md_bg_color: app.theme_cls.primary_color

            MDTextButton:
                text: "Отмена"
                text_color: app.theme_cls.text_color
                on_release: app.stop()

            BoxLayout:
                size_hint_x: 0.3

            MDTextButton:
                text: "Войти"
                bold: True
                font_size: dp(18)
                text_color: app.theme_cls.text_color
                on_release: root.login()

            BoxLayout:
                size_hint_x: 0.15

            MDTextButton:
                text: "Создать аккаунт"
                text_color: app.theme_cls.text_color
                on_release: app.root.current = "register"

        Image:
            source: "assets/koala.png"
            size_hint: None, None
            size: dp(150), dp(150)
            pos_hint: {"center_x": .5, "top": .82}

        MDLabel:
            text: "WordUp"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"center_x": .5, "y": .64}
            theme_text_color: "Primary"

        MDTextField:
            id: email
            hint_text: "E-mail"
            size_hint_x: .85
            pos_hint: {"center_x": .5, "y": .48}

        MDTextField:
            id: password
            hint_text: "Пароль"
            password: True
            size_hint_x: .85
            pos_hint: {"center_x": .5, "y": .39}

        MDRoundFlatButton:
            text: "Войти"
            md_bg_color: app.theme_cls.primary_color
            text_color: 1,1,1,1
            size_hint_x: .85
            height: dp(56)
            pos_hint: {"center_x": .5, "y": .2}
            on_release: root.login()

        MDLabel:
            id: error_label
            text: ""
            theme_text_color: "Error"
            halign: "center"
            pos_hint: {"center_x": .5, "y": .14}

# ===================== РЕГИСТРАЦИЯ (аналогично логину) =====================
<RegisterScreen>:
    name: "register"
    FloatLayout:
        MDBoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: [dp(16), dp(10)]
            pos_hint: {"top": 1}
            md_bg_color: app.theme_cls.primary_color

            MDTextButton:
                text: "Отмена"
                text_color: app.theme_cls.text_color
                on_release: app.root.current = "login"

            BoxLayout:
                size_hint_x: 0.3

            MDTextButton:
                text: "Регистрация"
                bold: True
                font_size: dp(18)
                text_color: app.theme_cls.text_color
                on_release: root.register()

        Image:
            source: "assets/koala.png"
            size_hint: None, None
            size: dp(150), dp(150)
            pos_hint: {"center_x": .5, "top": .82}

        MDLabel:
            text: "Регистрация в WordUp"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"center_x": .5, "y": .64}
            theme_text_color: "Primary"

        MDTextField:
            id: email
            hint_text: "E-mail"
            size_hint_x: .85
            pos_hint: {"center_x": .5, "y": .48}

        MDTextField:
            id: pwd1
            hint_text: "Пароль"
            password: True
            size_hint_x: .85
            pos_hint: {"center_x": .5, "y": .39}

        MDTextField:
            id: pwd2
            hint_text: "Повторите пароль"
            password: True
            size_hint_x: .85
            pos_hint: {"center_x": .5, "y": .30}

        MDRoundFlatButton:
            text: "Зарегистрироваться"
            md_bg_color: app.theme_cls.primary_color
            text_color: 1,1,1,1
            size_hint_x: .85
            height: dp(56)
            pos_hint: {"center_x": .5, "y": .2}
            on_release: root.register()

        MDLabel:
            id: error_label
            text: ""
            theme_text_color: "Error"
            halign: "center"
            pos_hint: {"center_x": .5, "y": .14}

# ===================== ГЛАВНЫЙ ЭКРАН С ТАБАМИ =====================
<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"
        MDTabs:
            id: tabs
            height: dp(48)
            tab_bar_height: dp(48)
            text_color_normal: app.theme_cls.text_color
            text_color_active: app.theme_cls.primary_color
            MDTab:
                name: "progress"
                text: "Прогресс"
                # Добавьте контент
            MDTab:
                name: "lessons"
                text: "Уроки"
                # Добавьте контент
            MDTab:
                name: "dictionary"
                text: "Словарь"
                # Добавьте контент

        MDLabel:
            id: welcome
            text: "Привет!"
            font_style: "H5"
            halign: "center"
            theme_text_color: "Primary"

        MDLabel:
            id: lang_label
            text: "Изучаешь: English → Русский"
            halign: "center"
            theme_text_color: "Secondary"

        MDLabel:
            id: streak_label
            text: "Стрик: 0 дней • Выучено: 0 слов"
            halign: "center"
            theme_text_color: "Secondary"

# ===================== СЛОВАРЬ =====================
<DictionaryScreen>:
    name: "dictionary"
    MDBoxLayout:
        orientation: "vertical"
        MDTextField:
            id: search_field
            hint_text: "Поиск слова"
            on_text: root.search(self.text)

        ScrollView:
            MDList:
                id: word_list

# ===================== КАРТОЧКИ =====================
<CardsScreen>:
    name: "cards"
    FloatLayout:
        MDCard:
            id: card
            size_hint: .8, .5
            pos_hint: {"center_x": .5, "center_y": .5}
            MDLabel:
                id: word_label
                text: "Word"
                halign: "center"
                theme_text_color: "Primary"

# ===================== AI КАРТОЧКИ =====================
<AICardsScreen>:
    name: "ai_cards"
    MDBoxLayout:
        orientation: "vertical"
        MDLabel:
            id: word_label
            text: "Word"
            halign: "center"
            theme_text_color: "Primary"

        MDTextField:
            id: answer_field
            hint_text: "Ваш ответ"

        MDRoundFlatButton:
            text: "Проверить"
            on_release: root.check_answer()

        MDLabel:
            id: result_label
            text: ""

# ===================== ПРОФИЛЬ =====================
<ProfileScreen>:
    name: "profile"
    FloatLayout:
        Image:
            source: "assets/koala.png"
            size_hint: None, None
            size: dp(160), dp(160)
            pos_hint: {"center_x": .5, "y": .75}

        MDLabel:
            id: user_email
            text: "email@example.com"
            font_style: "Subtitle1"
            bold: True
            halign: "center"
            pos_hint: {"center_x": .5, "y": .6}
            theme_text_color: "Secondary"

        MDRoundFlatButton:
            text: "Назад"
            size_hint_x: .85
            height: dp(56)
            pos_hint: {"center_x": .5, "y": .45}
            md_bg_color: app.theme_cls.primary_color
            text_color: 1,1,1,1
            on_release: app.root.current = "home"

        MDRoundFlatButton:
            text: "Выйти из аккаунта"
            size_hint_x: .85
            height: dp(56)
            pos_hint: {"center_x": .5, "y": .35}
            md_bg_color: app.theme_cls.accent_color
            text_color: 1,1,1,1
            on_release: root.logout()

# ===================== АДМИН =====================
<AdminScreen>:
    name: "admin"
    FloatLayout:
        MDLabel:
            text: "АДМИН-ПАНЕЛЬ"
            font_style: "H3"
            bold: True
            halign: "center"
            pos_hint: {"center_x": .5, "y": .88}
            theme_text_color: "Primary"

        ScrollView:
            size_hint: .94, .75
            pos_hint: {"center_x": .5, "y": .05}
            MDList:
                id: user_list
                padding: dp(10)

        MDRoundFlatButton:
            text: "Выйти из админки"
            size_hint_x: .85
            height: dp(56)
            pos_hint: {"center_x": .5, "y": .02}
            md_bg_color: app.theme_cls.primary_color
            text_color: 1,1,1,1
            on_release: app.root.current = "home"

# ===================== КАТЕГОРИИ =====================
<CategoriesScreen>:
    name: "categories"
    ScrollView:
        MDList:
            id: cat_list

# ===================== УРОКИ =====================
<LessonsScreen>:
    name: "lessons"
    ScrollView:
        MDBoxLayout:
            id: lessons_box
            orientation: "vertical"
            spacing: dp(10)
            padding: dp(10)

# ===================== ФЛЕШКАРТЫ =====================
<FlashcardsScreen>:
    name: "flashcards"
    MDBoxLayout:
        orientation: "vertical"
        MDCard:
            id: stack
            size_hint: 1, 1

# ===================== ПРАКТИКА =====================
<PracticeScreen>:
    name: "practice"
    MDLabel:
        text: "Практика"
        halign: "center"
        theme_text_color: "Primary"

# ===================== ЯЗЫК =====================
<LanguageScreen>:
    name: "language"
    MDBoxLayout:
        orientation: "vertical"
        MDRoundFlatButton:
            text: "English → Русский"
            on_release: root.choose_lang("en-ru")

        MDRoundFlatButton:
            text: "Русский → Армянский"
            on_release: root.choose_lang("ru-hy")

# ===================== СТАТИСТИКА =====================
<StatsScreen>:
    name: "stats"
    MDBoxLayout:
        orientation: "vertical"
        MDLabel:
            id: stats_label
            text: "Статистика"
            halign: "center"
            theme_text_color: "Primary"